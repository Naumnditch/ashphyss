# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres?sslmode=require

# Supabase Storage (past-papers PDF uploads — Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://uolwvcszclviqrtyxwgl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Shopier (Özelleştirmeler > API Bilgileri in the Shopier merchant panel).
# The callback/return URL is NOT an env var — it's configured once inside
# the Shopier panel itself: https://ashphys.org/api/payments/shopier/callback
SHOPIER_API_KEY=your-shopier-api-key
SHOPIER_API_SECRET=your-shopier-api-secret

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=24h

# Iyzico (Turkish Payment Processor)
NEXT_PUBLIC_IYZICO_API_KEY=your-iyzico-publishable-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# YouTube Integration
YOUTUBE_API_KEY=your-youtube-data-api-key

# Email (password resets + the messaging mailbox). Set ONE provider; if several
# are set, EMAIL_PROVIDER picks (resend | sendgrid | smtp), else the first below.
# With none set, mailbox messages are still delivered on-site at /dashboard/messages.
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDGRID_API_KEY=
# SMTP / Nodemailer, e.g. Gmail with an app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@ashphys.org
# Sender shown on mailbox emails (must be a verified sender/domain at your provider)
MAIL_FROM=AshPhys <messages@ashphys.org>
# Where students' email replies go. Leave unset to use the admin's own email (ADMIN_NOTIFY_EMAIL,
# else the admin account's address) and answer by hand. With MAIL_INBOUND_SECRET as well, the
# Reply-To becomes messages+<thread token>@… and replies are filed back into the mailbox: point
# that domain's inbound parse (SendGrid Inbound Parse, Postmark, Mailgun, or a Cloudflare Email
# Worker) at https://www.ashphys.org/api/messages/inbound?secret=MAIL_INBOUND_SECRET
MAIL_REPLY_TO=
MAIL_INBOUND_SECRET=
# Automatic retries of failed emails: a Supabase pg_cron job calls /api/cron/email-retry every
# 5 minutes (only when something is due) with "Authorization: Bearer $CRON_SECRET". The same
# value lives in Supabase Vault as email_retry_cron_secret.
CRON_SECRET=
# 'off' skips the DNS check (does the address's domain accept mail?) before each email
MAIL_VALIDATE_DNS=
# Where "a student replied" alerts go (comma-separated). Defaults to every admin account.
ADMIN_NOTIFY_EMAIL=
# Physical postal address printed in every email footer (CAN-SPAM requirement)
MAIL_POSTAL_ADDRESS=AshPhys, Street, City, Country

# Analytics (Optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ashphys.org

# Feature Flags
ENABLE_PAYMENTS=false
ENABLE_GAMIFICATION=false
